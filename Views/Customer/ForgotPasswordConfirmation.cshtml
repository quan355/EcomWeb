@{
   
    Layout = null;
}
<style>
    body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background-image: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=2070&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
    }

    .confirmation-container {
        background-color: #ffffff;
        padding: 2rem;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 400px;
        text-align: center;
    }

        .confirmation-container h2 {
            font-size: 24px;
            font-weight: bold;
            color: #1f2937;
            margin-bottom: 0.5rem;
        }

        .confirmation-container p {
            font-size: 14px;
            color: #4b5563;
            margin-bottom: 1rem;
        }

    .success-message {
        color: green;
        font-size: 14px;
        margin-bottom: 1rem;
    }

    .login-link a {
        color: #f5a623;
        text-decoration: none;
        font-size: 14px;
    }

        .login-link a:hover {
            text-decoration: underline;
        }
</style>
<body>
    <div class="confirmation-container">
        <h2>QUÊN MẬT KHẨU</h2>
        @if (TempData["SuccessMessage"] != null)
        {
            <p class="success-message">@TempData["SuccessMessage"]</p>
        }
        <p>Vui lòng kiểm tra hộp thư (bao gồm thư mục spam/junk) để nhận liên kết đặt lại mật khẩu.</p>
        <p class="login-link"><a href="@Url.Action("customerLogin", "Customer")">Quay lại Đăng nhập</a></p>
    </div>
</body>