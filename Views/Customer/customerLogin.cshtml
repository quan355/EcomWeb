
@{
    ViewData["Title"] = "customerLogin";
    Layout = null;
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Form</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-image: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=2070&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
        }

        .login-container {
            background-color: white;
            padding: 2rem;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
            width: 100%;
            max-width: 350px;
            text-align: center;
        }

            .login-container h2 {
                margin-bottom: 1.5rem;
                font-size: 1.5rem;
                color: #333;
            }

        .form-group {
            margin-bottom: 1rem;
            text-align: left;
        }

            .form-group label {
                display: block;
                margin-bottom: 0.5rem;
                color: #666;
                font-size: 0.9rem;
            }

            .form-group input {
                width: 100%;
                padding: 0.75rem;
                border: 1px solid #ddd;
                border-radius: 4px;
                font-size: 1rem;
                box-sizing: border-box;
            }

                .form-group input:focus {
                    outline: none;
                    border-color: #f4a261;
                }

        .login-btn {
            width: 100%;
            padding: 0.75rem;
            background-color: #f4a261;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 1rem;
            cursor: pointer;
            transition: background-color 0.2s;
        }

            .login-btn:hover {
                background-color: #e76f51;
            }

        .signup-link, .forgot-password-link {
            margin-top: 1rem;
            font-size: 0.9rem;
            text-align: left;
        }

            .signup-link a, .forgot-password-link a {
                color: #e76f51;
                text-decoration: none;
            }

                .signup-link a:hover, .forgot-password-link a:hover {
                    text-decoration: underline;
                }
    </style>
</head>
<body>
    <div class="login-container">
        <h2>LOGIN FORM</h2>
        <form method="post">
            <div class="form-group">
                <label for="username">Email address *</label>
                <input type="email" id="email" name="customerEmail" required>
            </div>
            <div class="form-group">
                <label for="password">Password *</label>
                <input type="password" id="password" name="customerPassword" required>
            </div>
            <p class="forgot-password-link"><a href="@Url.Action("forgotPassword","customer")">Forgot Password?</a></p>
            <button type="submit" class="login-btn">LOGIN</button>
            <p class="signup-link">Don't have an account? <a href="@Url.Action("customerRegistration","customer")">SIGN UP</a></p>
            <p>@ViewBag.message</p>
        </form>
    </div>
</body>

