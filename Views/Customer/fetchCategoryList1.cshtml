@model List<EComWeb.Models.Category>

@foreach (var cat in Model)
{
    var selectedCategoryIds = ViewData["selectedCategoryIds"] as int[] ?? new int[0];
    <div class="block-lst align-items-center d-flex justify-content-between">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="categoryIds" value="@cat.category_id" id="cat_@cat.category_id"
            @(selectedCategoryIds.Contains(cat.category_id) ? "checked" : "")>
            <label class="form-check-label" for="cat_@cat.category_id">
                @cat.category_name
            </label>
        </div>
    </div>
}