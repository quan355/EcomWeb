@model List<EComWeb.Models.Product>

@if (Model == null || !Model.Any())
{
    <p>No products found.</p>
}
else
{
    @foreach (var prod in Model)
    {
        <div class="col-lg-3 col-md-6 col-sm-12">
            <div class="block-product">
                <div class="product-thumb position-relative">
                            <a href="@Url.Action("productDetails", "Customer", new { id = prod.products_id })">
                        @{
                            // Xác định link ảnh hiển thị ban đầu
                            var displayImage = !string.IsNullOrEmpty(prod.products_image)
                                               ? prod.products_image
                                               : Url.Content("~/website/images/resources/default-product.png");
                        }

                            <img src="@displayImage" 
                                 alt="@prod.products_name" 
                                 onerror="this.onerror=null;this.src='@Url.Content("~/website/images/resources/default-product.png")';" />
                        </a>
                </div>
                <div class="product-body text-center">
                    <a href="#" class="brand-name">Actio</a>
                    <h2 class="product-name">
                        <a href="@Url.Action("productDetails", "Customer", new { id = prod.products_id })">@prod.products_name</a>
                    </h2>
                    <span class="product-price">@prod.products_price VND</span>
                </div>
            </div>
        </div>
    }
}