                        <div class="widget">
                            <h4 class="widget-title"></h4>
                            <ul class="widget-list list-unstyled">
                                <li>
                                    <a href=""></a>
                                </li>
                                <li>
                                    <a href="#"></a>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-2 col-sm-6">
                        <div class="widget">
                            <h4 class="widget-title">Tài Khoản</h4>
                            <ul class="widget-list list-unstyled">
                                <li>
                                    <a href="@Url.Action("customerRegistration","customer")">Đăng Ký</a>
                                </li>
                                <li>
                                    <a href="@Url.Action("customerLogin","customer")">Đăng Nhập</a>
                                </li>
                                <li>
                                    <a href="@Url.Action("customerUProfile","customer")">Trang Cá Nhân</a>
                                </li>
                                <li>
                                    <a href="@Url.Action("fetchCart","customer")">Giỏ Hàng</a>
                                </li> 
                                <li>
                                    <a href="@Url.Action("feedback","customer")">Liên Hệ</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="footer-bottom">
                    <div class="row justify-content-between">
                        <div class="col-12 col-md-auto py-1">
                            <p class="footer-copyright m-0"></p>
                            <ul class="footer-menu list-unstyled">
                                <li>
                                    <a href="#"></a>
                                </li>
                            </ul>
                        </div>
                        <div class="col-12 col-md-auto py-1">
                            <div class="socials d-flex align-items-center gap-3">
                                <span class="social-label">Social Media</span>
                                <ul class="list-unstyled d-flex align-items-center flex-wrap gap-3">
                                    <li><a href="#"><i class="fa-brands fa-facebook-f"></i></a></li>
                                    <li><a href="#"><i class="fa-brands fa-twitter"></i></a></li>
                                    <li><a href="#"><i class="fa-brands fa-google-plus-g"></i></a></li>
