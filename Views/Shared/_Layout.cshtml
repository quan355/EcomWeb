<head>
    <meta charset="utf-8">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Actio</title>
    <link rel="stylesheet" type="text/css" href="~/website/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/website/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="~/website/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/website/css/uicons-regular-rounded.css">
    <link rel="stylesheet" type="text/css" href="~/website/css/responsive.css">
</head>
<body>
    <header>
        <div class="w-100 bg-1 header-pd">
            <div class="container">
                <div class="top-bar d-flex flex-wrap align-items-center justify-content-between">
                    <div class="bar-left">  
                    </div>
                    <div class="bar-right">
                        <ul class="list-unstyled d-flex flex-wrap align-items-center gap-3">
                                @if (string.IsNullOrEmpty(ViewBag.checkSession))
                                {
                                <li><a href="@Url.Action("customerLogin","customer")"><i class="fa-regular fa-user"></i> Đăng Nhập</a></li>
                                }
                                else
                                {
                                <li><a href="@Url.Action("customerLogout","customer")"><i class="fa-regular fa-user"></i> Đăng Xuất</a></li>
                                }
                        </ul>
                    </div>
                </div>

            </div>
        </div>
        <div class="w-100 bg-white main-pd">
            <div class="container">
                <div class="main-header row w-100 d-flex align-items-center justify-content-between">
                    <div class="menu-left col-lg-4 col-md-4 d-flex flex-nowrap align-items-center">
                    </div>
                    <div class="menu-mid col-lg-4 col-md-4 text-lg-center">
                        <a href="Index.cshtml"><img src="~/website/images/logo.png" alt=""></a>
                    </div>
                    <div class="menu-right col-md-4 col-lg-4">
                        <ul class="shp-lst list-unstyled d-flex align-items-center justify-content-end">
                            <li><a style="font-weight: 500;" href="@Url.Action("OrderHistory","customer")"><img src="~/website/images/resources/icon-5.png" alt=""></a></li>
                            <li><a style="font-weight: 500;" href="@Url.Action("fetchCart","customer")"><img src="~/website/images/resources/icon-2.png" alt=""></a></li>
                            <li><a style="font-weight: 300;" href="@Url.Action("customerUProfile","customer")"><img src="~/website/images/resources/i-con3.png" alt=""></a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="w-100 header-bottom d-none d-lg-block">
            <div class="container">
                <div class="border-top" style="opacity: 0.5;"></div>
                <nav class="main-navigation">
                    <ul class="main-menu list-unstyled d-flex">
                        <li >
                            <a href="@Url.Action("index","customer")" ">Trang Chủ</a>
                        </li>
                        <li>
                            <a href="@Url.Action("allfetchProduct","customer")">Sản Phẩm </a>
                        </li>
                        <li>
                               <a href="@Url.Action("feedback","customer")">Liên Hệ</a> 
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </header>

    <div class="res-header w-100">
        <div class="res-topbar w-100">
            <div class="container">
                <div class="res-topbar-inner d-flex flex-wrap align-items-center justify-content-between">
                    <div class="logo">
                        <h1 class="mb-0">
                            <a href="Index.cshtml"><img src="~/website/images/logo.webp"></a>
                        </h1>
                    </div>
                    <ul class="shp-lst list-unstyled d-flex align-items-center justify-content-end">
                        <li class="bar">
                            <a class="responsive-menu-trigger d-inline-block" href="#" onclick="showMenu()"><i class="fi fi-rr-align-justify"></i></a>
                        </li>
                        <li><a style="font-weight: 300;" href="#"><img src="~/website/images/resources/icon-3.png" alt=""></a></li>
                        <li><a style="font-weight: 500;" href="#"><img src="~/website/images/resources/icon-4.png" alt=""></a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="mobile-nav position-relative">
        <div class="nav-links" id="navLinks">
            <a href="#" class="position-absolute res-menu-close" onclick="hideMenu()">
                <i class="fa-solid fa-xmark"></i>
            </a>
            <ul class="mobile-res list-unstyled mb-0">
                <li><a href="Index.cshtml">Home</a></li>
                <li>
                    <a class="collapsed" data-bs-toggle="collapse" data-bs-target="#mb-one" aria-controls="mb-one" href="Index.cshtml">Shop <i class="fa-solid fa-angle-down"></i></a>
                    <ul class="collapse children mb-0 w-100 list-unstyled" id="mb-one">
                        <li><a href="shop-fullwidth.html">Shop Fullwidth</a></li>
                        <li><a href="shop-sidebar.html">Shop With Sidebar</a></li>
                    </ul>
                </li>
                <li>
                    <a class="collapsed" data-bs-toggle="collapse" data-bs-target="#mb-two" aria-controls="mb-two" href="Index.cshtml">Product <i class="fa-solid fa-angle-down"></i></a>
                    <ul id="mb-two" class="collapse children mb-0 w-100 list-unstyled">
                        <li><a href="product-detail.html">Product-Detail</a></li>

                    </ul>
                </li>
                <li>
                    <a class="collapsed" data-bs-toggle="collapse" data-bs-target="#mb-three" aria-controls="mb-three">Pages <i class="fa-solid fa-angle-down"></i></a>
                    <ul id="mb-three" class="collapse children mb-0 w-100 list-unstyled">
                        <li><a href="@Url.Action("feedback","customer")">Contact Us</a></li>
                        <li><a href="faq.html">FAQs</a></li>
                        <li><a href="about.html">About Us</a></li>
                    </ul>
                </li>
                <li>
                    <a class="collapsed" data-bs-toggle="collapse" data-bs-target="#mb-four" aria-controls="mb-four" href="Index.cshtml">Blog <i class="fa-solid fa-angle-down"></i></a>
                    <ul id="mb-four" class="collapse children mb-0 w-100 list-unstyled">
                        <li><a href="blog-grid.html">Blog Grid</a></li>
                    </ul>
                </li>
                <li><a href="Index.cshtml">Buy Now</a></li>

            </ul>
        </div>
    </div>
    <script>
        var navLinks = document.getElementById("navLinks");
        function showMenu(){
          navLinks.style.right = "0";
        }
         function hideMenu(){
          navLinks.style.right = "-322px";
        }

    </script>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer>
        <div class="w-100 ft-main">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-12">
                        <div class="widget widget-about">
                            <a href="#" style="max-width: 11.0rem;display: block;">
                                <img class="footer-logo" src="~/website/images/logo.png" alt="">
                            </a>
                            <p class="ft-info">Chúng tôi cam kết mang đến cho bạn những sản phẩm thời trang chất lượng nhất, phù hợp với phong cách và nhu cầu của bạn. Khám phá bộ sưu tập của chúng tôi ngay hôm nay!.</p>
                            <div class="widget-info">
                                <div class="row">
                                    <div class="col-sm-6 col-md-4">
                                        <span class="widget-about-title"></span>
                                    </div>
                                    <div class="col-sm-6 col-md-8">

                                    </div>
