@model Product
<div class="container-fluid px-4">
    <h2 class="mt-4 text-center text-uppercase" style="letter-spacing:4px">Bạn có đồng ý xóa !!!</h2>
</div>
<div class="row">
    <div class="col-md-2"></div>
    <div class="col-md-8">
        <ul class="list-group my-3">
            <li class="list-group-item"> ID : @Model.products_id</li>
            <li class="list-group-item">Tên Sản Phẩm : @Model.products_name</li>
        </ul>
        <a href="@Url.Action("deleteProduct","Admin",new{id=Model.products_id})" class="btn btn-danger">XÓA</a>
        <a href="@Url.Action("fetchProduct","Admin",new{id=Model.products_id})" class="btn btn-danger">Quay Lại</a>
    </div>
    <div class="col-md-2"></div>
</div>