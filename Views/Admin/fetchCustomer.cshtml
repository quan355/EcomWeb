@model List<Customer>
<div class="container-fluid px-4">
    <h2 class="mt-4 text-center text-uppercase" style="letter-spacing:4px">Khách Hàng</h2>
</div>
<div class="row">
    <div class="col-md-12">
        <table class="table table-bordered table-striped text-center">
            <thead>
                <tr>
                    <th>Họ và Tên</th>
                    <th>Số Điện Thoại</th>
                    <th>Quốc Gia</th>
                    <th>Thành Phố</th>
                    <th>Địa chỉ</th>
                    <th>Tương Tác </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cust in Model)
                {
                    <tr>
                        <td>@cust.customer_name</td>
                        <td>@cust.customer_phone</td>
                        <td>@cust.customer_country</td>
                        <td>@cust.customer_city</td>
                        <td>@cust.customer_address</td>
                        <td>
                            <a href="@Url.Action("customerDetails","Admin",new{id=@cust.customer_id})" class="btn btn-primary">Thông Tin</a>
                            <a href="@Url.Action("deletePermission","Admin",new{id=@cust.customer_id})" class="btn btn-danger">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>