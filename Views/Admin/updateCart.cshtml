@model Cart
<div class="container-fluid px-4">
    <h2 class="mt-4 text-center text-uppercase" style="letter-spacing:4px">Chỉnh Sửa</h2>
</div>
<div class=" = row">
    <div class="col-md-2"></div>
    <div class="col-md-8">
        <form method="post">
            <input type="hidden" name="cart_id" value="@Model.cart_id" />
            <input type="hidden" name="product_id" value="@Model.product_id" />
            <input type="hidden" name="cust_id" value="@Model.cust_id" />
            <input type="hidden" name="product-quantity" value="@Model.product_quantity" />
            <select name="cart_status" class="form-select mt-3">
                <option value="0">Chờ Đợi</option>
                <option value="1">Đặt Hàng</option>
            </select>
            <input type="submit" value="Xác Nhận" class="form-control my-3 btn btn-primary" />
        </form>
    </div>
    <div class="col-md-2"></div>
</div>