<div class="container-fluid px-4">
    <h2 class="mt-4 text-center text-uppercase" style="letter-spacing:4px">Thêm Sản Phẩm</h2>
</div>
<div class="row">
    <div class="col-md-2"></div>
    <div class="col-md-8">
        <form method="post" enctype="multipart/form-data" asp-action="addProduct">
            <input type="text" name="products_name" class="form-control my-3" placeholder="Nhập tên sản phẩm" />
            <input type="text" name="products_price" class="form-control my-3" placeholder="Nhập giá sản phẩm" />
            <input type="text" name="products_description" class="form-control my-3" placeholder="Mô tả sản phẩm" />

            <!-- Preview ảnh -->
            <img id="preview" src="" style="display:none; width:200px; border-radius:8px;" class="my-2" />
            <input type="file" name="products_image" id="products_image" 
                   class="form-control my-3" accept="image/*" />

            @Html.Partial("CategoryDropdown", ViewData["category"])
            <input type="submit" value="Thêm sản phẩm" class="form-control my-3 btn btn-primary" />
        </form>
    </div>
    <div class="col-md-2"></div>
</div>

@section Scripts {
        <script>
            // Preview ảnh trước khi upload
            document.getElementById("products_image").addEventListener("change", function (e) {
                const file = e.target.files[0];
                if (!file) return;

                // Validate định dạng
                const allowedTypes = ["image/jpeg", "image/png", "image/webp"];
                if (!allowedTypes.includes(file.type)) {
                    alert("Chỉ chấp nhận file ảnh JPG, PNG, WEBP!");
                    this.value = "";
                    return;
                }

                // Validate kích thước (tối đa 2MB)
                if (file.size > 2 * 1024 * 1024) {
                    alert("Ảnh không được vượt quá 2MB!");
                    this.value = "";
                    return;
                }

                // Hiển thị preview
                const reader = new FileReader();
                reader.onload = (e) => {
                    const preview = document.getElementById("preview");
                    preview.src = e.target.result;
                    preview.style.display = "block";
                };
                reader.readAsDataURL(file);
            });
        </script>
}