@model Customer
<div class="container-fluid px-4">
    <h2 class="mt-4 text-center text-uppercase" style="letter-spacing:4px">Thông Tin Khách Hàng</h2>
</div>
<div class="row">
    <div class="col-md-2"></div>
    <div class="col-md-8">
        <img src="@("~/customer_image/"+Model.customer_image)" asp-append-version="true" width="250px" height="250px" class="my-3" />
        <ul class="list-group">
            <li class="list-group-item">ID   : @Model.customer_id</li>
            <li class="list-group-item">Họ và Tên  : @Model.customer_name</li>
            <li class="list-group-item">Số Điện Thoại : @Model.customer_phone</li>
            <li class="list-group-item">Địa chỉ Email : @Model.customer_email</li>
            <li class="list-group-item">Giới Tính : @Model.customer_gender</li>
            <li class="list-group-item">Quốc Gia : @Model.customer_country</li>
            <li class="list-group-item">Thành Phố : @Model.customer_city</li>
            <li class="list-group-item">Địa Chỉ : @Model.customer_address</li>

        </ul>
    </div>
    <div class="col-md-2"></div>
</div>