@model Category
<div class="container-fluid px-4">
    <h2 class="mt-4 text-center text-uppercase" style="letter-spacing:4px">Chỉnh sửa</h2>
</div>
<div class="row">
    <div class="col-md-2"></div>
    <div class="col-md-8">
        <form method="post">
            <input type="hidden" value="@Model.category_id" name="category_id"/>
            <input type="text" name="category_name" class="form-control my-3" value="@Model.category_name"  placeholder="Nhập tên loại hàng"/>
            <input type="submit" value="Thêm phân loại" class="form-control my-3 btn btn-primary" />
        </form>
    </div>
    <div class="col-md-2"></div>
</div>
