
@model List<Order>
<div class="container-fluid px-4">
    <h2 class="mt-4 text-center text-uppercase" style="letter-spacing:4px">Đơn Hàng</h2>
</div>
<div class="row">
    <div class="col-md-12">
        <table class="table table-bordered table-striped text-center">
            <thead>
                <tr>

                    <th>Tên Sản Phẩm</th>
                    <th>Tên Khách Hàng</th>
                    <th>Kích Cỡ</th>
                    <th>Số Lượng Sản Phẩm</th>
                    <th>Trạng Thái</th>
                    <th>Tương Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>

                        <td>@order.products.products_name</td>
                        <td>@order.customers.customer_name</td>
                        <td>@order.product_size</td>
                        <td>@order.product_quantity</td>
                        <td>@order.order_status</td>
                        <td>
                            <a href="@Url.Action("updateOrder","Admin",new{id=order.order_id})" class="btn btn-info">Cập nhật</a>
                            <a href="@Url.Action("deletePermissionOrder","Admin",new{id=@order.order_id})" class="btn btn-danger">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

